@model QuizQuestion

@{
    ViewBag.Title = "PC Build | Delete Quiz Question";
}

<h2>Are you sure you want to delete this question?</h2>

<p><strong>@Model.QuestionText</strong></p>

<form method="post">
    <p>
        <button type="submit" class="button danger">Yes, delete</button>
        <a href="@Url.Action("Index")" class="button secondary">Cancel</a>
    </p>
</form>

