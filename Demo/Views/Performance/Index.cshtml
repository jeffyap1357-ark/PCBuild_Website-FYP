@model PerformanceBuildVM
@using Demo.Services

@{
    ViewBag.Title = "PC Build | Performance Test";
    var parts = ViewBag.SelectedParts as List<Hardware> ?? new List<Hardware>();
    var savedId = ViewBag.SavedReportId as int?;
    var score = parts.Any() ? BuildAssessmentService.ComputeScore(parts) : 0;
    var assessment = parts.Any() ? BuildAssessmentService.GetAssessment(score, parts) : null;
}

<p>Set your budget, pick compatible components, and the system will calculate a performance score for your custom PC build.</p>

<form method="post" id="performance-form">
    <div asp-validation-summary="ModelOnly"></div>

    <p>
        <label asp-for="Budget"></label>
        <input asp-for="Budget" type="number" min="1000" max="50000" step="100" />
        <span asp-validation-for="Budget"></span>
    </p>

    <p><strong>Select components by category:</strong> <em>Choose CPU first to filter compatible motherboards, then RAM and case will be filtered automatically.</em></p>

    @for (var i = 0; i < Model.Categories.Count; i++)
    {
        var cat = Model.Categories[i];
        <p>
            <label>@cat.Type</label>
            <input type="hidden" asp-for="Categories[i].CategoryId" />
            <input type="hidden" asp-for="Categories[i].Type" />
            <select asp-for="Categories[i].SelectedHardwareId" class="hardware-select" data-category="@cat.Type" data-category-id="@cat.CategoryId">
                <option value="">-- None --</option>
                @foreach (var h in cat.Items)
                {
                    <option value="@h.HardwareId"
                            data-price="@h.Price"
                            data-socket="@(h.Socket ?? "")"
                            data-ddr="@(h.DdrType ?? "")"
                            data-formfactor="@(h.FormFactor ?? "")">
                        @h.Name - @h.Price.ToString("C")
                    </option>
                }
            </select>
        </p>
    }

    <p class="total-row">
        <strong>Estimated Total: </strong><span id="total-price">@Model.TotalPrice.ToString("C")</span>
    </p>

    <p>
        <button type="submit" class="button">Calculate Performance</button>
        <a href="@Url.Action("History")" class="button secondary">View History</a>
    </p>
</form>

@if (Model.HasResult && parts.Any())
{
    <hr />
    <h2>Performance Report</h2>
    <p>
        <strong>Budget:</strong> @Model.Budget.ToString("C")<br />
        <strong>Total Price:</strong> @Model.TotalPrice.ToString("C")<br />
        <strong>Total Performance Score:</strong> @Model.TotalScore
    </p>
    @if (assessment != null)
    {
        <div class="build-assessment">
            <strong>Assessment:</strong> @assessment.Rating<br />
            <p class="build-assessment-comment">@assessment.Comment</p>
            <p class="build-assessment-detail">
                <strong>Strengths:</strong> @assessment.Strengths &middot; <strong>Weaknesses:</strong> @assessment.Weaknesses
            </p>
        </div>
    }

    <table class="table">
        <thead>
            <tr>
                <th>Component</th>
                <th>Part</th>
                <th>Price</th>
                <th>Score</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in parts.OrderBy(p => p.Category?.Type))
            {
                <tr>
                    <td>@p.Category?.Type</td>
                    <td><a href="/Hardware/Detail/@p.HardwareId">@p.Name</a></td>
                    <td>@p.Price.ToString("C")</td>
                    <td>@(p.Special?.ToString() ?? "5")</td>
                </tr>
            }
        </tbody>
    </table>

    @if (savedId.HasValue)
    {
        <p><em>Report saved. You can review it later in <a href="@Url.Action("History")">History</a>.</em></p>
    }
}

@section foot {
    <script>
        (function () {
            var form = document.getElementById('performance-form');
            if (!form) return;
            var totalEl = document.getElementById('total-price');
            var selects = form.querySelectorAll('.hardware-select');

            function updateTotal() {
                var total = 0;
                selects.forEach(function (s) {
                    var opt = s.options[s.selectedIndex];
                    if (opt && opt.value) total += parseFloat(opt.getAttribute('data-price') || 0);
                });
                totalEl.textContent = '$' + total.toFixed(2);
            }

            selects.forEach(function (s) { s.addEventListener('change', updateTotal); });
            updateTotal();
        })();
    </script>
}

