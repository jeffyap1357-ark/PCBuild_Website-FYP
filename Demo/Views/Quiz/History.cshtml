@model List<QuizAttempt>

@{
    ViewBag.Title = "PC Build | Quiz History";
}

<p>Your past quiz attempts by level.</p>

@if (!Model.Any())
{
    <p>No quiz history yet. Try the <a href="@Url.Action("LevelsView")">PC Knowledge Test</a>.</p>
}
else
{
    <div class="quiz-history-list">
        @foreach (var a in Model)
        {
            var level = string.IsNullOrEmpty(a.Level) ? "Mixed" : a.Level;
            var isFull = a.TotalQuestions > 0 && a.CorrectCount == a.TotalQuestions;
            var levelClass = level.Equals("Beginner", StringComparison.OrdinalIgnoreCase) ? "quiz-history-level-beginner"
                : level.Equals("Normal", StringComparison.OrdinalIgnoreCase) ? "quiz-history-level-normal"
                : "quiz-history-level-professional";
            <article class="quiz-history-card @(isFull ? "quiz-history-full" : "")">
                <header>
                    <div>
                        <strong>
                            <span class="quiz-history-level @levelClass">@level</span>
                        </strong>
                        <div class="quiz-history-meta">
                            Attempt #@a.QuizAttemptId · @a.TakenAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                        </div>
                    </div>
                    <div class="quiz-history-score">
                        @a.CorrectCount / @a.TotalQuestions
                    </div>
                </header>
                <footer>
                    <a href="@Url.Action("Detail", new { id = a.QuizAttemptId })" class="button secondary">View details</a>
                </footer>
            </article>
        }
    </div>
}
