@model FeedbackReportVM

@{
    ViewBag.Title = "PC Build | Feedback Report";
}

<h2>Overview</h2>

@if (Model.TotalCount == 0)
{
    <p>No feedback yet.</p>
}
else
{
    <p>
        <strong>Average rating:</strong> @Model.AverageRating.ToString("0.0") / 5<br />
        <strong>Total feedback:</strong> @Model.TotalCount
    </p>

    <h3>Rating distribution</h3>
    <div class="feedback-admin-chart-wrap">
        <canvas id="chart-feedback-admin" width="400" height="220"></canvas>
    </div>
    <table class="table">
        <thead>
            <tr>
                <th>Rating</th>
                <th>Count</th>
                <th>Percentage</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in Model.Distribution.OrderByDescending(d => d.Rating))
            {
                <tr>
                    <td>@d.Rating</td>
                    <td>@d.Count</td>
                    <td>@d.Percentage.ToString("0.0")%</td>
                </tr>
            }
        </tbody>
    </table>

    <h3>Recent feedback</h3>
    <table class="table">
        <thead>
            <tr>
                <th>Date</th>
                <th>Rating</th>
                <th>Module</th>
                <th>User</th>
                <th>Comment</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var f in Model.Feedbacks)
            {
                <tr>
                    <td>@f.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@f.Rating</td>
                    <td>@(string.IsNullOrEmpty(f.ModuleName) ? "-" : f.ModuleName)</td>
                    <td>@(f.User?.Username ?? "-")</td>
                    <td>@(string.IsNullOrEmpty(f.Comment) ? "-" : f.Comment)</td>
                </tr>
            }
        </tbody>
    </table>
}

@section head {
@if (Model.TotalCount > 0)
{
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
}
}

@section foot {
@if (Model.TotalCount > 0)
{
<script>
(function() {
    var data = @Html.Raw(ViewBag.ChartData ?? "[]");
    if (data.length > 0 && typeof Chart !== 'undefined') {
        new Chart(document.getElementById('chart-feedback-admin'), {
            type: 'bar',
            data: {
                labels: data.map(function(x) { return 'Rating ' + x.rating; }),
                datasets: [{
                    label: 'Count',
                    data: data.map(function(x) { return x.count; }),
                    backgroundColor: ['rgba(239, 68, 68, 0.6)', 'rgba(249, 115, 22, 0.6)', 'rgba(234, 179, 8, 0.6)', 'rgba(34, 197, 94, 0.6)', 'rgba(59, 130, 246, 0.6)'],
                    borderColor: ['rgba(239, 68, 68, 1)', 'rgba(249, 115, 22, 1)', 'rgba(234, 179, 8, 1)', 'rgba(34, 197, 94, 1)', 'rgba(59, 130, 246, 1)'],
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } }
            }
        });
    }
})();
</script>
}
}

