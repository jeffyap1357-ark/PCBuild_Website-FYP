@model ResetPasswordVM

@{
    ViewBag.Title = "Account | Reset Password";
    ViewBag.HideMainTitle = true;
}

<div class="auth-page">
    <div class="auth-card">
        <h2>Reset Password</h2>
        <p style="margin: 0 0 20px 0; font-size: 0.9rem; color: var(--text-muted);">Enter your email to receive a new password.</p>
        <form class="auth-form" method="post">
            <div asp-validation-summary="ModelOnly"></div>

            <div class="form-group">
                <label asp-for="Email">Email</label>
                <input asp-for="Email" type="email" placeholder="your@email.com" autofocus>
                <span asp-validation-for="Email"></span>
            </div>

            <div class="form-actions">
                <button type="submit" class="button">Send Reset</button>
                <a href="/Account/Login" class="button secondary">Back to Login</a>
            </div>
        </form>

        <div class="auth-links">
            <a href="/Account/Login">Sign in</a> &nbsp;|&nbsp;
            <a href="/Account/Register">Create account</a>
        </div>
    </div>
</div>
