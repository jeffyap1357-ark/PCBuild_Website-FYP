@model UpdatePasswordVM

@{
    ViewBag.Title = "Account | Update Password";
    ViewBag.HideMainTitle = true;
}

<div class="auth-page">
    <div class="auth-card">
        <h2>Change Password</h2>
        <form class="auth-form" method="post">
            <div asp-validation-summary="ModelOnly"></div>

            <div class="form-group">
                <label asp-for="Current">Current Password</label>
                <input asp-for="Current" placeholder="Current password" autofocus>
                <span asp-validation-for="Current"></span>
            </div>

            <div class="form-group">
                <label asp-for="New">New Password</label>
                <input asp-for="New" placeholder="At least 5 characters">
                <span asp-validation-for="New"></span>
            </div>

            <div class="form-group">
                <label asp-for="Confirm">Confirm Password</label>
                <input asp-for="Confirm" placeholder="Confirm new password">
                <span asp-validation-for="Confirm"></span>
            </div>

            <div class="form-actions">
                <button type="submit" class="button">Update</button>
                <a href="/Account/UpdateProfile" class="button secondary">Back to Profile</a>
            </div>
        </form>

        <div class="auth-links">
            <a href="/Account/UpdateProfile">Update Profile</a> &nbsp;|&nbsp;
            <a href="/">Home</a>
        </div>
    </div>
</div>
