@model Hardware
@inject Demo.Helper Helper

@{
    ViewBag.Title = "Hardware | " + Model.Name;
}

<div class="hardware-detail">
    @{
        var imgFile = Helper.GetHardwareImagePath(Model.Picture, Model.Name);
    }
    <div class="hardware-detail-layout">
        <div class="hardware-detail-image-wrap">
            @if (!string.IsNullOrEmpty(imgFile))
            {
                <img src="/hardware/@imgFile" alt="@Model.Name" class="hardware-detail-picture">
            }
            else
            {
                <div class="hardware-detail-placeholder">No image</div>
            }
        </div>
        <div class="hardware-detail-info">
            <dl class="detail-list">
                <dt>Name</dt>
                <dd>@Model.Name</dd>
                <dt>Category</dt>
                <dd>@Model.Category?.Type</dd>
                <dt>Brand</dt>
                <dd>@(Model.Brand ?? "—")</dd>
                <dt>Price</dt>
                <dd>@Model.Price.ToString("C")</dd>
                <dt>Description</dt>
                <dd>@(Model.Detail ?? "No description available.")</dd>
            </dl>
        </div>
    </div>

    <p>
        <a href="@Url.Action("List")" class="button">← Back to Hardware List</a>
    </p>
</div>
