@model Hardware
@inject Demo.Helper Helper

@{
    ViewBag.Title = "Hardware | " + Model.Name;
}

<div class="hardware-detail">
    @{
        var imgFile = Helper.GetHardwareImagePath(Model.Picture, Model.Name);
    }
    <div class="hardware-detail-layout">
        <div class="hardware-detail-image-wrap">
            @if (!string.IsNullOrEmpty(imgFile))
            {
                <img src="/hardware/@imgFile" alt="@Model.Name" class="hardware-detail-picture">
            }
            else
            {
                <div class="hardware-detail-placeholder">No image</div>
            }
        </div>
        <div class="hardware-detail-info">
            <dl class="detail-list">
                <dt>Name</dt>
                <dd>@Model.Name</dd>
                <dt>Category</dt>
                <dd>@Model.Category?.Type</dd>
                <dt>Brand</dt>
                <dd>@(Model.Brand ?? "—")</dd>
                <dt>Price</dt>
                <dd>@Model.Price.ToString("C")</dd>
                @if (Model.ReleaseYear.HasValue)
                {
                    <dt>Release Year</dt>
                    <dd>@Model.ReleaseYear</dd>
                }
                @if (Model.Rating.HasValue)
                {
                    <dt>Rating</dt>
                    <dd>@Model.Rating / 5</dd>
                }
                @if (!string.IsNullOrEmpty(Model.Socket))
                {
                    <dt>Socket</dt>
                    <dd>@Model.Socket</dd>
                }
                @if (!string.IsNullOrEmpty(Model.DdrType))
                {
                    <dt>DDR Type</dt>
                    <dd>@Model.DdrType</dd>
                }
                @if (!string.IsNullOrEmpty(Model.FormFactor))
                {
                    <dt>Form Factor</dt>
                    <dd>@Model.FormFactor</dd>
                }
                @if (Model.PowerConsumption.HasValue)
                {
                    <dt>Power Consumption</dt>
                    <dd>@Model.PowerConsumption W</dd>
                }
                @if (Model.GamingScore.HasValue || Model.OfficeScore.HasValue || Model.EditingScore.HasValue)
                {
                    <dt>Suitability</dt>
                    <dd>
                        @if (Model.GamingScore.HasValue) { <span>Gaming: @Model.GamingScore/10</span> }
                        @if (Model.OfficeScore.HasValue) { <span>Office: @Model.OfficeScore/10</span> }
                        @if (Model.EditingScore.HasValue) { <span>Editing: @Model.EditingScore/10</span> }
                    </dd>
                }
                <dt>Description</dt>
                <dd>@(Model.Detail ?? "No description available.")</dd>
            </dl>
        </div>
    </div>

    <p class="hardware-detail-actions">
        <a href="@Url.Action("Compare", new { id1 = Model.HardwareId })" class="button">⚖ Compare with another @(Model.Category?.Type ?? "item")</a>
        <a href="@Url.Action("List")" class="button secondary">← Back to Hardware List</a>
    </p>
</div>
