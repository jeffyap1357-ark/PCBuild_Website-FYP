@model List<Hardware>
@inject Demo.Helper Helper

@{
    ViewBag.Title = "Hardware | List";
    var categories = ViewBag.Categories as List<Category>;
    var selectedCategoryId = ViewBag.SelectedCategoryId as int?;
}

<div class="hardware-list-page">
    <aside class="hardware-filter-sidebar" id="filter-sidebar">
        <div class="hardware-filter-title">Components</div>
        <nav class="hardware-filter-nav">
            <a href="@Url.Action("List")" class="hardware-filter-link @(selectedCategoryId == null ? "active" : "")">All</a>
            @if (categories != null)
            {
                @foreach (var c in categories)
                {
                    <a href="@Url.Action("List", new { categoryId = c.CategoryId })" class="hardware-filter-link @(selectedCategoryId == c.CategoryId ? "active" : "")">@c.Type</a>
                }
            }
        </nav>
    </aside>

    <div class="hardware-list-main">
        <div class="hardware-list-header">
            <div class="hardware-search-wrap">
                <input type="text" id="hardware-search" class="hardware-search" placeholder="Search hardware..." autocomplete="off">
            </div>
            <button type="button" class="hardware-filter-toggle" id="filter-toggle" title="Show/Hide filter bar">
                <span class="filter-icon" aria-hidden="true">≡</span>
                <span class="filter-label" id="filter-label">Filter</span>
            </button>
        </div>

        @if (!Model.Any())
        {
            <p class="hardware-empty">No hardware found.</p>
        }
        else
        {
            <p class="hardware-no-results" id="hardware-no-results" style="display:none">No results found.</p>
            <div class="hardware-card-grid">
                @foreach (var h in Model)
                {
                    <a href="@Url.Action("Detail", new { id = h.HardwareId })" class="hardware-card" data-search="@((h.Name + " " + (h.Category?.Type ?? "") + " " + (h.Brand ?? "")).ToLowerInvariant())">
                        <div class="hardware-card-image">
                            @{
                                var imgFile = Helper.GetHardwareImagePath(h.Picture, h.Name);
                            }
                            @if (!string.IsNullOrEmpty(imgFile))
                            {
                                <img src="/hardware/@imgFile" alt="@h.Name" onerror="this.onerror=null;this.style.display='none';var p=this.nextElementSibling;if(p)p.style.display='flex';">
                                <span class="hardware-card-placeholder" style="display:none">No image</span>
                            }
                            else
                            {
                                <span class="hardware-card-placeholder">No image</span>
                            }
                        </div>
                        <div class="hardware-card-body">
                            <div class="hardware-card-name">@h.Name</div>
                            <div class="hardware-card-meta">@(h.Category?.Type) @(h.Brand != null ? "· " + h.Brand : "")</div>
                            <div class="hardware-card-price">@h.Price.ToString("C")</div>
                        </div>
                    </a>
                }
            </div>
        }
    </div>
</div>

@section foot {
<script>
(function() {
    var sidebar = document.getElementById('filter-sidebar');
    var toggle = document.getElementById('filter-toggle');
    var label = document.getElementById('filter-label');
    var key = 'hardware-filter-visible';

    function isVisible() {
        return localStorage.getItem(key) !== 'false';
    }

    function applyState() {
        var v = isVisible();
        sidebar.classList.toggle('visible', v);
        toggle.classList.toggle('active', v);
        if (label) label.textContent = v ? 'Hide filter' : 'Show filter';
    }

    toggle.addEventListener('click', function() {
        localStorage.setItem(key, !isVisible());
        applyState();
    });

    applyState();

    // Search
    var searchInput = document.getElementById('hardware-search');
    var cards = document.querySelectorAll('.hardware-card');
    var grid = document.querySelector('.hardware-card-grid');
    var noResults = document.getElementById('hardware-no-results');

    if (searchInput && grid) {
        searchInput.addEventListener('input', function() {
            var q = (this.value || '').trim().toLowerCase();
            var visible = 0;
            cards.forEach(function(card) {
                var text = (card.getAttribute('data-search') || '');
                var match = !q || text.indexOf(q) !== -1;
                card.style.display = match ? '' : 'none';
                if (match) visible++;
            });
            if (noResults) noResults.style.display = q && visible === 0 ? 'block' : 'none';
        });
    }
})();
</script>
}
