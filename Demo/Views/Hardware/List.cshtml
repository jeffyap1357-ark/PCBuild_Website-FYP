@model List<Hardware>
@inject Demo.Helper Helper

@{
    ViewBag.Title = "Hardware | List";
    var categories = ViewBag.Categories as List<Category>;
    var brands = ViewBag.Brands as List<string>;
    var selectedCategoryId = ViewBag.SelectedCategoryId as int?;
    var selectedBrand = ViewBag.SelectedBrand as string ?? "";
}

<div class="hardware-list-page">
    <aside class="hardware-filter-sidebar" id="filter-sidebar">
        <div class="hardware-filter-title">Filter</div>
        <div class="hardware-filter-search">
            <input type="text" id="hardware-search" class="hardware-search" placeholder="Search hardware..." autocomplete="off">
        </div>
        <div class="hardware-filter-group">
            <label class="hardware-filter-label">Component</label>
            <select id="hardware-category" class="hardware-filter-select">
                <option value="">All</option>
                @if (categories != null)
                {
                    @foreach (var c in categories)
                    {
                        @if (selectedCategoryId == c.CategoryId)
                        {
                            <option value="@c.CategoryId" selected>@c.Type</option>
                        }
                        else
                        {
                            <option value="@c.CategoryId">@c.Type</option>
                        }
                    }
                }
            </select>
        </div>
        <div class="hardware-filter-group">
            <label class="hardware-filter-label">Brand</label>
            <select id="hardware-brand" class="hardware-filter-select">
                <option value="">All</option>
                @if (brands != null)
                {
                    @foreach (var b in brands)
                    {
                        @if (selectedBrand == b)
                        {
                            <option value="@b" selected>@b</option>
                        }
                        else
                        {
                            <option value="@b">@b</option>
                        }
                    }
                }
            </select>
        </div>
    </aside>

    <div class="hardware-list-main">
        <div class="hardware-list-header">
            <button type="button" class="hardware-filter-toggle" id="filter-toggle" title="Show/Hide filter bar">
                <span class="filter-icon" aria-hidden="true">≡</span>
                <span class="filter-label" id="filter-label">Filter</span>
            </button>
        </div>

        <div id="hardware-list-content">
            @await Html.PartialAsync("_HardwareCardGrid", Model)
        </div>
    </div>
</div>

@section foot {
<script>
(function() {
    var sidebar = document.getElementById('filter-sidebar');
    var toggle = document.getElementById('filter-toggle');
    var label = document.getElementById('filter-label');
    var key = 'hardware-filter-visible';

    function isVisible() {
        return localStorage.getItem(key) !== 'false';
    }

    function applyState() {
        var v = isVisible();
        sidebar.classList.toggle('visible', v);
        toggle.classList.toggle('active', v);
        if (label) label.textContent = v ? 'Hide filter' : 'Show filter';
    }

    toggle.addEventListener('click', function() {
        localStorage.setItem(key, !isVisible());
        applyState();
    });

    applyState();

    var searchTimer;
    var contentEl = document.getElementById('hardware-list-content');

    function fetchHardware() {
        var cat = document.getElementById('hardware-category')?.value || '';
        var brand = document.getElementById('hardware-brand')?.value || '';
        var search = document.getElementById('hardware-search')?.value?.trim() || '';
        var params = new URLSearchParams();
        if (cat) params.set('categoryId', cat);
        if (brand) params.set('brand', brand);
        if (search) params.set('search', search);

        var url = '/Hardware/ListPartial' + (params.toString() ? '?' + params.toString() : '');
        fetch(url)
            .then(function(r) { return r.text(); })
            .then(function(html) {
                if (contentEl) contentEl.innerHTML = html;
            })
            .catch(function() {
                if (contentEl) contentEl.innerHTML = '<p class="hardware-empty">Error loading hardware.</p>';
            });
    }

    document.getElementById('hardware-category')?.addEventListener('change', fetchHardware);
    document.getElementById('hardware-brand')?.addEventListener('change', fetchHardware);

    document.getElementById('hardware-search')?.addEventListener('input', function() {
        clearTimeout(searchTimer);
        searchTimer = setTimeout(fetchHardware, 350);
    });
})();
</script>
}
