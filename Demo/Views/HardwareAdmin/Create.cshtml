@model HardwareEditVM
@{
    ViewBag.Title = "Admin | Add hardware";
    var categories = ViewBag.Categories as List<Category>;
}

<h2>Add hardware</h2>
<p class="admin-hint">Choose the category first so you know which fields to fill for compatibility (e.g. Socket for CPU/Motherboard, DdrType for Motherboard/RAM, Form factor for Motherboard/Case, RAM slots for Motherboard, Power for CPU/GPU/PSU).</p>

<form method="post" enctype="multipart/form-data" class="admin-form">
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    <div class="form-group">
        <label for="CategoryId">Category <span class="required">*</span></label>
        <select id="CategoryId" name="CategoryId" required>
            <option value="">— Select category —</option>
            @if (categories != null)
            {
                foreach (var c in categories)
                {
                    if (Model.CategoryId == c.CategoryId)
                    {
                        <option value="@c.CategoryId" selected>@c.Type</option>
                    }
                    else
                    {
                        <option value="@c.CategoryId">@c.Type</option>
                    }
                }
            }
        </select>
    </div>

    <div class="form-group">
        <label for="Name">Name <span class="required">*</span></label>
        <input type="text" id="Name" name="Name" value="@Model.Name" maxlength="200" required />
        @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger" })
    </div>

    <div class="form-group">
        <label for="Price">Price <span class="required">*</span></label>
        <input type="number" id="Price" name="Price" value="@Model.Price" step="0.01" min="0" required />
    </div>

    <div class="form-group">
        <label for="Detail">Detail</label>
        <textarea id="Detail" name="Detail" rows="3" maxlength="2000">@Model.Detail</textarea>
    </div>

    <div class="form-group">
        <label for="Brand">Brand</label>
        <input type="text" id="Brand" name="Brand" value="@Model.Brand" maxlength="100" />
    </div>

    <div class="form-group">
        <label for="PictureFile">Display image (showing) <span class="required">*</span></label>
        <input type="file" id="PictureFile" name="PictureFile" accept=".jpg,.jpeg,.png" required />
        <span class="field-hint">JPG or PNG. Stored with unique name to avoid duplicates.</span>
        @Html.ValidationMessageFor(m => m.PictureFile, "", new { @class = "text-danger" })
    </div>

    <div class="form-group">
        <label for="CleanPictureFile">Clean image (for build diagram) <span class="required">*</span></label>
        <input type="file" id="CleanPictureFile" name="CleanPictureFile" accept=".jpg,.jpeg,.png" required />
        <span class="field-hint">Transparent/clean version for configurator. Stored with unique name.</span>
        @Html.ValidationMessageFor(m => m.CleanPictureFile, "", new { @class = "text-danger" })
    </div>

    <fieldset class="compat-fields">
        <legend>Compatibility (fill as needed for the category)</legend>
        <div class="form-row">
            <div class="form-group">
                <label for="Socket">Socket (CPU / Motherboard)</label>
                <input type="text" id="Socket" name="Socket" value="@Model.Socket" maxlength="50" placeholder="e.g. AM5, LGA1700" />
            </div>
            <div class="form-group">
                <label for="DdrType">DDR type (Motherboard / RAM)</label>
                <input type="text" id="DdrType" name="DdrType" value="@Model.DdrType" maxlength="20" placeholder="e.g. DDR5, DDR4" />
            </div>
        </div>
        <div class="form-row">
            <div class="form-group">
                <label for="FormFactor">Form factor (Motherboard / Case)</label>
                <input type="text" id="FormFactor" name="FormFactor" value="@Model.FormFactor" maxlength="50" placeholder="e.g. ATX, Micro-ATX" />
            </div>
            <div class="form-group">
                <label for="RamSlots">RAM slots (Motherboard)</label>
                <input type="number" id="RamSlots" name="RamSlots" value="@Model.RamSlots" min="0" max="8" placeholder="2 or 4" />
            </div>
        </div>
        <div class="form-group">
            <label for="PowerConsumption">Power (W) (CPU / GPU / PSU)</label>
            <input type="number" id="PowerConsumption" name="PowerConsumption" value="@Model.PowerConsumption" min="0" placeholder="Watts" />
        </div>
    </fieldset>

    <fieldset>
        <legend>Scores &amp; optional</legend>
        <div class="form-row">
            <div class="form-group">
                <label for="ReleaseYear">Release year</label>
                <input type="number" id="ReleaseYear" name="ReleaseYear" value="@Model.ReleaseYear" min="1990" max="2030" />
            </div>
            <div class="form-group">
                <label for="Rating">Rating (1–5)</label>
                <input type="number" id="Rating" name="Rating" value="@Model.Rating" min="1" max="5" />
            </div>
            <div class="form-group">
                <label for="PerformanceScore">Performance score (0–100)</label>
                <input type="number" id="PerformanceScore" name="PerformanceScore" value="@Model.PerformanceScore" min="0" max="100" />
            </div>
        </div>
        <div class="form-row">
            <div class="form-group">
                <label for="Special">Special (1–10)</label>
                <input type="number" id="Special" name="Special" value="@Model.Special" min="0" max="10" />
            </div>
            <div class="form-group">
                <label for="GamingScore">Gaming (1–10)</label>
                <input type="number" id="GamingScore" name="GamingScore" value="@Model.GamingScore" min="0" max="10" />
            </div>
            <div class="form-group">
                <label for="OfficeScore">Office (1–10)</label>
                <input type="number" id="OfficeScore" name="OfficeScore" value="@Model.OfficeScore" min="0" max="10" />
            </div>
            <div class="form-group">
                <label for="EditingScore">Editing (1–10)</label>
                <input type="number" id="EditingScore" name="EditingScore" value="@Model.EditingScore" min="0" max="10" />
            </div>
        </div>
        <div class="form-group">
            <label for="Reference">Reference URL</label>
            <input type="url" id="Reference" name="Reference" value="@Model.Reference" maxlength="500" />
        </div>
    </fieldset>

    <div class="form-actions">
        <button type="submit" class="button">Save</button>
        <a href="@Url.Action("Index")" class="button secondary">Cancel</a>
    </div>
</form>
