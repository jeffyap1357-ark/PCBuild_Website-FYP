@model List<Hardware>
@{
    ViewBag.Title = "Admin | Hardware";
    var categories = ViewBag.Categories as List<Category>;
    var selectedCategoryId = ViewBag.SelectedCategoryId as int?;
}

<h2>Hardware</h2>
<p><a href="@Url.Action("Create")" class="button">Add hardware</a></p>

@if (categories != null && categories.Any())
{
    <div class="admin-filter">
        <label>Filter by category:</label>
        <select onchange="location.href=this.value ? '/HardwareAdmin?categoryId='+this.value : '/HardwareAdmin'">
            <option value="">All</option>
            @foreach (var c in categories)
            {
                if (selectedCategoryId == c.CategoryId)
                {
                    <option value="@c.CategoryId" selected>@c.Type</option>
                }
                else
                {
                    <option value="@c.CategoryId">@c.Type</option>
                }
            }
        </select>
    </div>
}

@if (!Model.Any())
{
    <p>No hardware in this category.</p>
}
else
{
    <table class="table admin-hardware-table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Category</th>
                <th>Price</th>
                <th>Rating</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var h in Model)
            {
                <tr>
                    <td>@h.Name</td>
                    <td>@(h.Category?.Type ?? "")</td>
                    <td>@h.Price.ToString("N2")</td>
                    <td>@(h.Rating?.ToString() ?? "—")</td>
                    <td>
                        <a href="@Url.Action("Edit", new { id = h.HardwareId })">Edit</a>
                        <form method="post" action="@Url.Action("Delete", new { id = h.HardwareId })" style="display:inline;" onsubmit="return confirm('Delete this hardware?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="link-button">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
