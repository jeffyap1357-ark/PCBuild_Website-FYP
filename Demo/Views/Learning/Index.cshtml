@model List<Guide>

@{
    ViewBag.Title = "PC Build | Learning & Guide";
    var readIds = ViewBag.ReadIds as HashSet<int> ?? new HashSet<int>();
}

<p>Browse learning materials. Select a guide to read. Items you have read will show in a different color. <a href="@Url.Action("Diagnose")">Diagnose DB</a></p>

<ul class="guide-list">
    @foreach (var g in Model)
    {
        var read = readIds.Contains(g.GuideId);
        <li class="@(read ? "guide-read" : "")">
            <span class="guide-status">@(read ? "✓" : "○")</span>
            <div>
                <a href="@Url.Action("Detail", new { id = g.GuideId })">@g.GuideName</a>
                @if (!string.IsNullOrEmpty(g.GuideDesc))
                {
                    <span class="guide-desc">@g.GuideDesc</span>
                }
            </div>
            <a href="@Url.Action("Detail", new { id = g.GuideId })" class="button">View</a>
        </li>
    }
</ul>
