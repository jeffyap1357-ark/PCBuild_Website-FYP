@model FeedbackCreateVM

@{
    // Show only after completing a module, once per day (triggered by TempData or ?showFeedback=1).
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var moduleName = $"{controller}/{action}";
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}

@{
    var feedbackUserKey = User.Identity?.Name ?? "guest";
}
<div id="feedback-panel-wrap" class="feedback-modal-wrap" style="display:none;" data-trigger="@(ViewBag.ShowFeedback == true ? "1" : "0")" data-user="@feedbackUserKey">
    <div class="feedback-modal-backdrop" id="feedback-backdrop"></div>
    <div id="feedback-panel" class="feedback-modal">
    <form asp-controller="Feedback" asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ModuleName" value="@moduleName" />
        <input type="hidden" asp-for="PageUrl" value="@returnUrl" />
        <input type="hidden" asp-for="ReturnUrl" value="@returnUrl" />

        <p><strong>Rate your experience (1–5):</strong></p>
        <div class="feedback-rating-options">
            @for (int r = 1; r <= 5; r++)
            {
                <label>
                    <input type="radio" asp-for="Rating" value="@r" />
                    @r
                </label>
            }
        </div>

        <p>
            <label asp-for="Comment"></label><br />
            <textarea asp-for="Comment" rows="2" cols="40" placeholder="Describe your experience or any issues you faced (optional)"></textarea>
        </p>

        <p class="feedback-actions">
            <button type="submit" class="button">Submit</button>
            <button type="button" id="feedback-later" class="button secondary">I will do it later</button>
        </p>
    </form>
</div>
</div>

<script>
(function () {
    var wrap = document.getElementById('feedback-panel-wrap');
    if (!wrap) return;

    function bindCloseOnce() {
        var laterBtn = document.getElementById('feedback-later');
        var backdrop = document.getElementById('feedback-backdrop');
        if (laterBtn && !laterBtn.dataset.fbCloseBound) {
            laterBtn.dataset.fbCloseBound = '1';
            laterBtn.addEventListener('click', function () {
                wrap.style.display = 'none';
            });
        }
        if (backdrop && !backdrop.dataset.fbCloseBound) {
            backdrop.dataset.fbCloseBound = '1';
            backdrop.addEventListener('click', function () {
                wrap.style.display = 'none';
            });
        }
    }

    function openFeedbackPanel() {
        bindCloseOnce();
        wrap.style.display = 'flex';
    }
    window.openFeedbackPanel = openFeedbackPanel;

    var manualBtn = document.getElementById('feedback-manual-trigger');
    if (manualBtn) {
        manualBtn.addEventListener('click', function () {
            openFeedbackPanel();
        });
    }

    if (!window.localStorage) return;
    if (wrap.getAttribute('data-trigger') !== '1') return;
    var userKey = wrap.getAttribute('data-user') || 'guest';
    var storageKey = 'feedbackLastShownDate_' + userKey;
    var today = new Date().toISOString().slice(0, 10);
    if (localStorage.getItem(storageKey) === today) return;
    localStorage.setItem(storageKey, today);
    openFeedbackPanel();
})();
</script>

