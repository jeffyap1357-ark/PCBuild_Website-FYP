<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>
    <link rel="shortcut icon" href="/images/favicon.png">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&family=Roboto:wght@400;700&display=swap">
    <link rel="stylesheet" href="/css/pager.css">
    <link rel="stylesheet" href="/css/app.css" asp-append-version="true">
    @RenderSection("head", false)
</head>
@{
    var path = Context.Request.Path.Value ?? "";
    var isAdminSite = User.IsInRole(Roles.Admin) && (
        path.Equals("/Admin", StringComparison.OrdinalIgnoreCase) ||
        path.StartsWith("/Admin/", StringComparison.OrdinalIgnoreCase) ||
        path.StartsWith("/HardwareAdmin", StringComparison.OrdinalIgnoreCase) ||
        path.StartsWith("/LearningAdmin", StringComparison.OrdinalIgnoreCase) ||
        path.StartsWith("/QuizAdmin", StringComparison.OrdinalIgnoreCase) ||
        path.StartsWith("/FeedbackAdmin", StringComparison.OrdinalIgnoreCase) ||
        path.StartsWith("/AdminAccount", StringComparison.OrdinalIgnoreCase) ||
        path.StartsWith("/UsersAdmin", StringComparison.OrdinalIgnoreCase));
}
<body class="@(isAdminSite ? "body-admin-site" : "") @(User.Identity?.IsAuthenticated == true ? "chatbot-logged-in" : "")">
    <div class="info">@Html.Raw(TempData["Info"])</div>

    <header>
        <h1><a href="/">PC Build</a></h1>

        @if (User.Identity!.IsAuthenticated)
        {
            <div class="header-user" id="nav-user">
                <button type="button" class="header-user-trigger" id="nav-user-trigger" title="Account" aria-label="Account" aria-expanded="false" aria-haspopup="true">
                    @await Component.InvokeAsync("UserAvatar")
                    <span class="header-user-name">@User.Identity.Name</span>
                </button>
                <div class="nav-user-dropdown" id="nav-user-dropdown" role="menu" hidden>
                    <a href="/Account/UpdateProfile" role="menuitem">Update Profile</a>
                    <a href="/Account/UpdatePassword" role="menuitem">Update Password</a>
                    <a href="/Account/Logout" role="menuitem">Log out</a>
                </div>
            </div>
        }
    </header>

    <nav class="nav-icons @(isAdminSite ? "nav-icons--admin-only" : "")">
        @if (User.Identity!.IsAuthenticated && isAdminSite)
        {
            <a href="/Admin" title="Dashboard" aria-label="Dashboard">Dashboard</a>
            <a href="/HardwareAdmin" title="Hardware CRUD" aria-label="Hardware CRUD">Hardware</a>
            <a href="/LearningAdmin/Index" title="Learning maker" aria-label="Learning maker">Learning</a>
            <a href="/QuizAdmin/Index" title="Quiz admin" aria-label="Quiz admin">Quiz</a>
            <a href="/FeedbackAdmin/Index" title="Feedback admin" aria-label="Feedback admin">Feedback</a>
            <a href="/AdminAccount/Index" title="Admin accounts" aria-label="Admin accounts">Admin Accounts</a>
            <a href="/UsersAdmin" title="User accounts" aria-label="User accounts">Users</a>
            <div class="nav-spacer"></div>
            <a href="/" class="nav-site-switch" title="Back to user site">User site</a>
        }
        else if (!User.Identity!.IsAuthenticated)
        {
            <a href="/" title="Home" aria-label="Home"><img src="/icon/home.png" alt=""></a>
            <a href="/Hardware/List" title="Hardware List" aria-label="Hardware List"><img src="/icon/hardwarelist.png" alt=""></a>
            <a href="/Learning/Index" title="Learning & Guide" aria-label="Learning & Guide"><img src="/icon/learning.png" alt=""></a>
            <a href="/Community/Index" title="Community" aria-label="Community"><img src="/icon/community.png" alt=""></a>
            <a href="/Recommend" title="Recommend Build" aria-label="Recommend Build"><img src="/icon/recommend.png" alt=""></a>
            <div class="nav-spacer"></div>
            <a href="/Account/Login">Login</a>
            <a href="/Account/Register">Register</a>
            <a href="/Account/ResetPassword">Reset Password</a>
        }
        else
        {
            <a href="/" title="Home" aria-label="Home"><img src="/icon/home.png" alt=""></a>
            <a href="/Hardware/List" title="Hardware List" aria-label="Hardware List"><img src="/icon/hardwarelist.png" alt=""></a>
            <a href="/Learning/Index" title="Learning & Guide" aria-label="Learning & Guide"><img src="/icon/learning.png" alt=""></a>
            <a href="/Community/Index" title="Community" aria-label="Community"><img src="/icon/community.png" alt=""></a>
            <a href="/Recommend" title="Recommend Build" aria-label="Recommend Build"><img src="/icon/recommend.png" alt=""></a>
            <a href="/Build/Configure" title="PC Build Config" aria-label="PC Build Config"><img src="/icon/pcbuild.png" alt=""></a>
            <a href="/Build/Index" title="My Builds" aria-label="My Builds"><img src="/icon/mybuild.png" alt=""></a>
            <a href="/Quiz/LevelsView" title="Quiz" aria-label="Quiz"><img src="/icon/quizz.png" alt=""></a>
            <a href="/Performance/Index" title="Performance Build" aria-label="Performance Build"><img src="/icon/perfomence.png" alt=""></a>
            <div class="nav-spacer"></div>
            @if (User.IsInRole(Roles.Admin))
            {
                <a href="/Admin" class="nav-site-switch" title="Admin site">Admin site</a>
            }
        }
    </nav>

    <main class="@(ViewBag.IsHomePage == true ? "home-page" : "")">
        @if (ViewBag.HideMainTitle != true)
        {
            <h1>@ViewBag.Title</h1>
        }
        @RenderBody()
    </main>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <footer>
        </footer>
    }

    @if (!isAdminSite)
    {
        @await Html.PartialAsync("_Chatbot")
        @if (User.Identity?.IsAuthenticated == true)
        {
            ViewBag.ShowFeedback = TempData["ShowFeedback"] as bool? == true ||
                string.Equals(Context.Request.Query["showFeedback"], "1", StringComparison.OrdinalIgnoreCase);
            @await Html.PartialAsync("_FeedbackPrompt", new Demo.Models.FeedbackCreateVM())
        }
    }

    <script src="/js/jquery.min.js"></script>
    <script src="/js/jquery.unobtrusive-ajax.min.js"></script>
    <script src="/js/jquery.validate.min.js"></script>
    <script src="/js/jquery.validate.unobtrusive.min.js"></script>
    <script src="/js/app.js" asp-append-version="true"></script>
    @RenderSection("foot", false)
</body>
</html>
