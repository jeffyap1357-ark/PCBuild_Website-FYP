<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>
    <link rel="shortcut icon" href="/logo/logo.png">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&family=Roboto:wght@400;700&display=swap">
    <link rel="stylesheet" href="/css/pager.css">
    <link rel="stylesheet" href="/css/app.css" asp-append-version="true">
    @RenderSection("head", false)
</head>
<body>
    @if (TempData["Info"] != null) { <div class="info">@Html.Raw(TempData["Info"])</div> }
    @if (TempData["Error"] != null) { <div class="error">@Html.Raw(TempData["Error"])</div> }

    <header>
        <h1><a href="/">PC Build</a></h1>

        @if (User.Identity!.IsAuthenticated)
        {
            <div class="user-menu-wrap">
                <button type="button" class="user-avatar" id="user-menu-btn" title="@User.Identity.Name">
                    <span class="user-avatar-inner">@(User.Identity.Name?.Length > 0 ? User.Identity.Name[0].ToString().ToUpperInvariant() : "?")</span>
                </button>
                <div class="user-dropdown" id="user-dropdown">
                    <div class="user-dropdown-name">@User.Identity.Name</div>
                    <a href="/Account/UpdateProfile">Update Profile</a>
                    <a href="/Account/UpdatePassword">Update Password</a>
                    <a href="/Account/Logout">Logout</a>
                </div>
            </div>
        }
    </header>

    <nav>
        <a href="/">Home</a>
        <a href="/Hardware/List">Hardware List</a>
        <a href="/Learning/Index">📚 Learning & Guide</a>
        <a href="/Community/Index">👥 Community</a>
        <a href="/Recommend">✨ Recommend Build</a>
        @if (User.Identity!.IsAuthenticated)
        {
            <a href="/Build/Configure">PC Build Config</a>
            <a href="/Build/Index">My Builds</a>
        }

        <div></div>

        @if (!User.Identity.IsAuthenticated)
        {
            <a href="/Account/Login">Login</a>
            <a href="/Account/Register">Register</a>
            <a href="/Account/ResetPassword">Reset Password</a>
        }
    </nav>

    <main>
        <h1>@ViewBag.Title</h1>
        @RenderBody()
    </main>

    <footer>
        PC Build &middot;
        Copyright &copy; @DateTime.Today.Year
    </footer>

    <script>
        (function() {
            var btn = document.getElementById('user-menu-btn');
            var dropdown = document.getElementById('user-dropdown');
            if (btn && dropdown) {
                btn.addEventListener('click', function(e) {
                    e.stopPropagation();
                    dropdown.classList.toggle('open');
                });
                document.addEventListener('click', function() {
                    dropdown.classList.remove('open');
                });
            }
        })();
    </script>
    <script src="/js/jquery.min.js"></script>
    <script src="/js/jquery.unobtrusive-ajax.min.js"></script>
    <script src="/js/jquery.validate.min.js"></script>
    <script src="/js/jquery.validate.unobtrusive.min.js"></script>
    <script src="/js/app.js" asp-append-version="true"></script>
    @RenderSection("foot", false)
</body>
</html>
