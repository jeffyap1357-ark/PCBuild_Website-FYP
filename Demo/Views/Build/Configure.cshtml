@model ConfigureBuildVM

@{
    ViewBag.Title = "PC Build | Configure";
}

<form method="post" id="configure-form">
    <div asp-validation-summary="ModelOnly"></div>

    <p>
        <label asp-for="BuildName"></label>
        <input asp-for="BuildName" placeholder="e.g. My Gaming PC">
        <span asp-validation-for="BuildName"></span>
    </p>

    <p><strong>Select components by category:</strong> <em>Choose Motherboard first to filter compatible CPU and RAM.</em></p>

    @for (var i = 0; i < Model.Categories.Count; i++)
    {
        var cat = Model.Categories[i];
        <p>
            <label>@cat.Type</label>
            <input type="hidden" asp-for="Categories[i].CategoryId" />
            <input type="hidden" asp-for="Categories[i].Type" />
            <select asp-for="Categories[i].SelectedHardwareId" class="hardware-select" data-category="@cat.Type" data-category-id="@cat.CategoryId">
                <option value="">-- None --</option>
                @foreach (var h in cat.Items)
                {
                    <option value="@h.HardwareId" data-price="@h.Price" data-socket="@(h.Socket ?? "")" data-ddr="@(h.DdrType ?? "")">@h.Name - @h.Price.ToString("C")</option>
                }
            </select>
        </p>
    }

    <p class="total-row">
        <strong>Total: </strong><span id="total-price">@Model.Categories.Sum(c => c.Items.FirstOrDefault(i => i.HardwareId == c.SelectedHardwareId)?.Price ?? 0).ToString("C")</span>
    </p>

    <p>
        <button type="submit">Save Build</button>
        <a href="@Url.Action("Index")" class="button secondary">Cancel</a>
    </p>
</form>

@section foot {
    <script>
        (function () {
            var form = document.getElementById('configure-form');
            var totalEl = document.getElementById('total-price');
            var selects = form.querySelectorAll('.hardware-select');
            var mbSelect = form.querySelector('.hardware-select[data-category="Motherboard"]');
            var cpuSelect = form.querySelector('.hardware-select[data-category="CPU"]');
            var ramSelect = form.querySelector('.hardware-select[data-category="RAM"]');

            function updateTotal() {
                var total = 0;
                selects.forEach(function (s) {
                    var opt = s.options[s.selectedIndex];
                    if (opt && opt.value) total += parseFloat(opt.getAttribute('data-price') || 0);
                });
                totalEl.textContent = '$' + total.toFixed(2);
            }

            function filterByMotherboard() {
                if (!mbSelect || !cpuSelect || !ramSelect) return;
                var mbOpt = mbSelect.options[mbSelect.selectedIndex];
                var socket = mbOpt ? (mbOpt.getAttribute('data-socket') || '') : '';
                var ddr = mbOpt ? (mbOpt.getAttribute('data-ddr') || '') : '';
                function filterSelect(sel, attr) {
                    var val = sel.value;
                    for (var i = 1; i < sel.options.length; i++) {
                        var o = sel.options[i];
                        var match = !attr || (attr === 'socket' && (!socket || o.getAttribute('data-socket') === socket)) || (attr === 'ddr' && (!ddr || o.getAttribute('data-ddr') === ddr));
                        o.style.display = match ? '' : 'none';
                        o.disabled = !match;
                    }
                    if (val && sel.options[sel.selectedIndex].disabled) sel.value = '';
                }
                filterSelect(cpuSelect, 'socket');
                filterSelect(ramSelect, 'ddr');
                updateTotal();
            }

            if (mbSelect) mbSelect.addEventListener('change', filterByMotherboard);
            selects.forEach(function (s) { s.addEventListener('change', updateTotal); });
            updateTotal();
            filterByMotherboard();
        })();
    </script>
}
