@model RecommendBuildVM
@using Demo.Models
@using Demo.Services

@{
    ViewBag.Title = "PC Build | Recommend Build";
    var result = ViewBag.Result as RecommendResult;
    var budget = ViewBag.Budget as decimal? ?? Model.Budget;
}

<div class="recommend-page">
    <div class="recommend-intro">
        <p>Enter your budget and optimization preference. The system filters components by compatibility and applies a weighted scoring formula to recommend the best build for your needs.</p>
    </div>

    <div class="recommend-form-card">
        <form method="post" class="recommend-form">
            <div asp-validation-summary="ModelOnly" class="recommend-validation"></div>
            <div class="recommend-form-row">
                <label asp-for="Budget"></label>
                <input asp-for="Budget" type="number" min="1000" max="50000" step="100" class="recommend-input" />
                <span asp-validation-for="Budget" class="recommend-error"></span>
            </div>
            <div class="recommend-form-row">
                <label asp-for="OptimizationType"></label>
                <select asp-for="OptimizationType" class="recommend-select">
                    <option value="@OptimizationType.Performance">Performance-focused — prioritizes CPU/GPU performance</option>
                    <option value="@OptimizationType.Budget">Budget-focused — prioritizes value-for-money</option>
                    <option value="@OptimizationType.Balanced">Balanced — mix of performance and value</option>
                    <option value="@OptimizationType.Gaming">Gaming-focused — uses gaming suitability score</option>
                    <option value="@OptimizationType.Office">Office-focused — uses office/productivity score</option>
                    <option value="@OptimizationType.Editing">Editing-focused — uses content editing score</option>
                </select>
            </div>
            <div class="recommend-form-actions">
                <button type="submit" class="button">Get Recommendation</button>
            </div>
        </form>
    </div>

    @if (result != null)
    {
        <div class="recommend-result">
            @if (result.Success)
            {
                @if (result.Warnings.Any())
                {
                    <div class="recommend-warnings">
                        @foreach (var w in result.Warnings)
                        {
                            <p class="warning">@w</p>
                        }
                    </div>
                }
                <div class="recommend-summary">
                    <span class="recommend-total">Total: @result.TotalPrice.ToString("C")</span>
                    @if (result.TotalPrice > budget)
                    {
                        <span class="recommend-over">(over budget)</span>
                    }
                </div>
                <div class="recommend-parts-card">
                    <table class="recommend-table">
                        <thead>
                            <tr>
                                <th>Component</th>
                                <th>Part</th>
                                <th>Price</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in result.Parts.OrderBy(p => p.Category?.Type))
                            {
                                <tr>
                                    <td class="recommend-component">@p.Category?.Type</td>
                                    <td><a href="/Hardware/Detail/@p.HardwareId">@p.Name</a></td>
                                    <td class="recommend-price">@p.Price.ToString("C")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="recommend-actions">
                        <form method="post" action="@Url.Action("SaveBuild")">
                            @foreach (var p in result.Parts)
                            {
                                <input type="hidden" name="hardwareIds" value="@p.HardwareId" />
                            }
                            <input type="hidden" name="buildName" value="Recommended Build" />
                            <button type="submit" class="button">Save Build</button>
                        </form>
                        <form method="post" action="@Url.Action("ConfigureBuild")">
                            @foreach (var p in result.Parts)
                            {
                                <input type="hidden" name="hardwareIds" value="@p.HardwareId" />
                            }
                            <input type="hidden" name="buildName" value="Recommended Build" />
                            <button type="submit" class="button secondary">Configure Build</button>
                        </form>
                    </div>
                    <p class="recommend-hint">
                        <strong>Save Build</strong> — saves directly to My Builds. <strong>Configure Build</strong> — opens the configuration page so you can edit before saving.
                    </p>
                }
                else
                {
                    <p class="recommend-login"><a href="@Url.Action("Login", "Account")">Log in</a> to save or configure this build.</p>
                }
            }
            else
            {
                <div class="recommend-fail">
                    <h3>Could not build</h3>
                    <div class="recommend-warnings">
                        @foreach (var w in result.Warnings)
                        {
                            <p class="warning">@w</p>
                        }
                    </div>
                    <p>Try increasing your budget or check that hardware data is loaded from the CSV.</p>
                </div>
            }
        </div>
    }
</div>
