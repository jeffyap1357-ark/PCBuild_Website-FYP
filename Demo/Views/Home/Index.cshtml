@using System.Collections.Generic
@{
    ViewBag.Title = "PC Build | Home";
}

<section class="home-hero">
    <div class="home-hero-cta-wrap">
        <p class="home-hero-heading">Start Build Your PC</p>
        <a href="/Build/Configure" class="home-hero-build-btn">Build</a>
    </div>
</section>

<section class="home-learn-more" aria-label="Learn more">
    <div class="home-learn-more-inner">
        <h2 class="home-learn-more-title">Learn more</h2>
        <p class="home-learn-more-kicker">Newest fact</p>
        <div class="home-learn-more-grid" role="list">
            <a class="home-learn-more-box" role="listitem" href="https://www.wikihow.com/Install-a-Graphics-Card" target="_blank" rel="noopener noreferrer">
                <span class="home-learn-more-box-text">PC build install</span>
            </a>
            <a class="home-learn-more-box" role="listitem" href="https://www.allithypermarket.com.my/collections/pc-computer-parts?srsltid=AfmBOorfpkdAGT8zZzCZ_v46JPkv4gusLTKJ9xyzCiCX97CCmR904-Ps" target="_blank" rel="noopener noreferrer">
                <span class="home-learn-more-box-text">PC hardware seller</span>
            </a>
            <a class="home-learn-more-box" role="listitem" href="https://www.coursera.org/courses?query=computer%20hardware&amp;utm_medium=sem&amp;utm_source=gg&amp;utm_campaign=b2c_apac_x_multi_ftcof_career-academy_cx_dr_bau_gg_pmax_pr_s3_en_m_hyb_25-04_desktop&amp;campaignid=22420706570&amp;adgroupid=&amp;device=c&amp;keyword=&amp;matchtype=&amp;network=x&amp;devicemodel=&amp;creativeid=&amp;assetgroupid=6566453505&amp;targetid=&amp;extensionid=&amp;placement=&amp;gad_source=1&amp;gad_campaignid=22424263906&amp;gbraid=0AAAAADdKX6Zs0YJm552EgBTP4458NX9Y9&amp;gclid=Cj0KCQjwkMjOBhC5ARIsADIdb3dgrSEHsU_dKVEoSCp0W0elEUnP3qeXXqhitM_hXTV9UCN3QdGyIVIaAluOEALw_wcB" target="_blank" rel="noopener noreferrer">
                <span class="home-learn-more-box-text">PC learning</span>
            </a>
        </div>
    </div>
</section>

<section class="home-rated-bar" aria-label="Higher rated hardware">
    <div class="home-rated-bar-inner">
        @{
            var list = ViewBag.TopRatedHardware as IList<Demo.Models.Hardware>;
            var categories = ViewBag.Categories as IList<Demo.Models.Category>;
        }
        <h2 class="home-rated-bar-title">The Higher Rated Hardware</h2>
        <nav class="home-rated-nav" aria-label="Filter by category">
            <div class="home-rated-cat-buttons" role="group" aria-label="Choose hardware category">
                <button type="button" class="home-rated-cat-btn is-active" data-category-id="" aria-pressed="true">All</button>
                @if (categories != null)
                {
                    foreach (var c in categories)
                    {
                        <button type="button" class="home-rated-cat-btn" data-category-id="@c.CategoryId" aria-pressed="false">@c.Type</button>
                    }
                }
            </div>
        </nav>
        <div id="home-top-rated-panel" class="home-top-rated-panel">
            @await Html.PartialAsync("_HomeTopRatedGrid", list ?? new List<Hardware>())
        </div>
    </div>
</section>

<section class="home-quiz-section" aria-label="Test your knowledge">
    <div class="home-quiz-inner">
        <h2 class="home-quiz-title">Test Your Knowledge</h2>
        <div class="home-quiz-row">
            <div class="home-quiz-left">
                <img src="/images/image_2.png" alt="" class="home-quiz-image" />
            </div>
            <div class="home-quiz-box">
                <h3 class="home-quiz-box-title">Beginner</h3>
                <p class="home-quiz-box-desc">New to PC building? Start here with basic questions on parts and compatibility.</p>
                <a href="/Quiz/LevelsView" class="home-quiz-try-btn">Try</a>
            </div>
            <div class="home-quiz-box">
                <h3 class="home-quiz-box-title">Normal</h3>
                <p class="home-quiz-box-desc">You know the basics. Test yourself on common builds and components.</p>
                <a href="/Quiz/LevelsView" class="home-quiz-try-btn">Try</a>
            </div>
            <div class="home-quiz-box">
                <h3 class="home-quiz-box-title">Professional</h3>
                <p class="home-quiz-box-desc">For seasoned builders. Tough questions on specs, performance, and optimization.</p>
                <a href="/Quiz/LevelsView" class="home-quiz-try-btn">Try</a>
            </div>
        </div>
    </div>
</section>

<section class="home-why-section" aria-label="Why us">
    <div class="home-why-inner">
        <h2 class="home-why-title">Why US</h2>
        <div class="home-why-boxes">
            <div class="home-why-box">
                <img src="/images/image_3.png" alt="" class="home-why-box-img" />
                <h3 class="home-why-box-title">Build</h3>
                <ul class="home-why-list">
                    <li>Pick parts by category with compatibility checks</li>
                    <li>Visual diagram and drag-and-drop configurator</li>
                    <li>Save drafts and compare builds</li>
                </ul>
            </div>
            <div class="home-why-box">
                <img src="/images/image_4.png" alt="" class="home-why-box-img" />
                <h3 class="home-why-box-title">Quiz</h3>
                <p class="home-why-desc">Test your PC building knowledge with multiple-choice questions and track your results.</p>
            </div>
            <div class="home-why-box">
                <img src="/images/image_5.png" alt="" class="home-why-box-img" />
                <h3 class="home-why-box-title">Performance Test</h3>
                <p class="home-why-desc">Get a performance score for your build and see how it fits your budget and goals.</p>
            </div>
        </div>
    </div>
</section>

@section foot {
<script>
(function () {
    var wrap = document.querySelector('.home-rated-cat-buttons');
    var panel = document.getElementById('home-top-rated-panel');
    if (!wrap || !panel) return;
    function loadGrid(categoryId) {
        var url = '/Home/TopRatedGrid' + (categoryId ? '?categoryId=' + encodeURIComponent(categoryId) : '');
        panel.setAttribute('aria-busy', 'true');
        fetch(url, { credentials: 'same-origin', headers: { 'Accept': 'text/html', 'X-Requested-With': 'XMLHttpRequest' } })
            .then(function (r) { if (!r.ok) throw new Error(); return r.text(); })
            .then(function (html) { panel.innerHTML = html; })
            .catch(function () {
                panel.innerHTML = '<p class="home-rated-empty">Could not load hardware. Please try again.</p>';
            })
            .finally(function () { panel.removeAttribute('aria-busy'); });
    }
    wrap.addEventListener('click', function (e) {
        var btn = e.target.closest('.home-rated-cat-btn');
        if (!btn || !wrap.contains(btn)) return;
        var id = btn.getAttribute('data-category-id') || '';
        wrap.querySelectorAll('.home-rated-cat-btn').forEach(function (b) {
            var on = b === btn;
            b.classList.toggle('is-active', on);
            b.setAttribute('aria-pressed', on ? 'true' : 'false');
        });
        loadGrid(id);
    });
})();
</script>
}
