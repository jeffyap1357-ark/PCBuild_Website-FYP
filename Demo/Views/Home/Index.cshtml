@{
    ViewBag.Title = "PC Build | Home";
}

<h1>PC Build</h1>
<p>Welcome to PC Build. Create and manage your PC builds.</p>
<ul>
    <li><a href="/Hardware/List">Hardware List</a> – Browse components (CPU, GPU, RAM, etc.)</li>
    <li><a href="/Learning/Index">Learning & Guide</a> – PC building tutorials and tips</li>
    @if (User.Identity!.IsAuthenticated)
    {
        <li><a href="/Build/Configure">PC Build Config</a> – Create a new build</li>
        <li><a href="/Build/Index">My Builds</a> – Your saved builds</li>
        <li><a href="/Quiz/Index">Quiz</a> – Test your PC building knowledge</li>
        <li><a href="/Performance/Index">Performance Build</a> – Build and score your PC by budget</li>
        @if (User.IsInRole(Roles.Admin))
        {
            <li><a href="/Admin">Admin</a> – Admin dashboard</li>
            <li><a href="/QuizAdmin/Index">Quiz Admin</a> – Manage quiz questions</li>
            <li><a href="/FeedbackAdmin/Index">Feedback Admin</a> – View feedback reports</li>
        }
    }
    else
    {
        <li><a href="/Account/Login">Login</a> or <a href="/Account/Register">Register</a> to create builds</li>
    }
</ul>
