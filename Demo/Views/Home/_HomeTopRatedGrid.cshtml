@model IList<Demo.Models.Hardware>
@inject Demo.Helper Helper

@if (Model == null || !Model.Any())
{
    <p class="home-rated-empty">No rated hardware in this category yet.</p>
}
else
{
    <div class="home-rated-grid">
        @for (var i = 0; i < Model.Count; i++)
        {
            var h = Model[i];
            var imgFile = Helper.GetHardwareImagePath(h.Picture, h.Name);
            <a href="/Hardware/Detail/@h.HardwareId" class="home-rated-card" title="@h.Name">
                <div class="home-rated-card-image-wrap">
                    @if (!string.IsNullOrEmpty(imgFile))
                    {
                        <img src="/hardware/@imgFile" alt="@h.Name" loading="lazy" />
                    }
                    else
                    {
                        <span class="home-rated-card-noimg">No image</span>
                    }
                </div>
                <div class="home-rated-card-body">
                    <span class="home-rated-card-name">@h.Name</span>
                    <span class="home-rated-card-price">@h.Price.ToString("N2")</span>
                    @if (h.Rating.HasValue)
                    {
                        <span class="home-rated-card-rating">★ @h.Rating</span>
                    }
                </div>
            </a>
        }
    </div>
}
