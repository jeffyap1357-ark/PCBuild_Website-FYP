@model AdminDashboardVM

@{
    ViewBag.Title = "Admin | Dashboard";
}

<div class="admin-dashboard">
    <h2>Admin Dashboard</h2>
    <p class="admin-dashboard-welcome">Welcome, @User.Identity?.Name. You have admin access.</p>

    <div class="admin-stat-cards">
        <div class="admin-stat-card">
            <span class="admin-stat-value">@Model.UserCount</span>
            <span class="admin-stat-label">Users</span>
        </div>
        <div class="admin-stat-card">
            <span class="admin-stat-value">@Model.BuildCount</span>
            <span class="admin-stat-label">Builds</span>
        </div>
        <div class="admin-stat-card">
            <span class="admin-stat-value">@Model.HardwareCount</span>
            <span class="admin-stat-label">Hardware</span>
        </div>
        <div class="admin-stat-card">
            <span class="admin-stat-value">@Model.QuizAttemptCount</span>
            <span class="admin-stat-label">Quiz Attempts</span>
        </div>
        <div class="admin-stat-card">
            <span class="admin-stat-value">@Model.PerformanceReportCount</span>
            <span class="admin-stat-label">Performance Reports</span>
        </div>
        <div class="admin-stat-card">
            <span class="admin-stat-value">@Model.FeedbackCount</span>
            <span class="admin-stat-label">Feedbacks</span>
        </div>
        <div class="admin-stat-card">
            <span class="admin-stat-value">@Model.CommunityCount</span>
            <span class="admin-stat-label">Shared Builds</span>
        </div>
    </div>

    <div class="admin-charts">
        <div class="admin-chart-card">
            <h3>User Level (Role)</h3>
            <canvas id="chart-users" width="400" height="220"></canvas>
        </div>
        <div class="admin-chart-card">
            <h3>Hardware by Category</h3>
            <canvas id="chart-hardware" width="400" height="220"></canvas>
        </div>
        <div class="admin-chart-card">
            <h3>Feedback Rating Distribution</h3>
            <canvas id="chart-feedback" width="400" height="220"></canvas>
        </div>
    </div>

</div>

@section head {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
}

@section foot {
<script>
(function() {
    var usersData = @Html.Raw(ViewBag.UsersByRoleData ?? "[]");
    var hardwareData = @Html.Raw(ViewBag.HardwareChartData ?? "[]");
    var feedbackData = @Html.Raw(ViewBag.FeedbackChartData ?? "[]");

    if (usersData.length > 0 && typeof Chart !== 'undefined') {
        new Chart(document.getElementById('chart-users'), {
            type: 'pie',
            data: {
                labels: usersData.map(function(x) { return x.label; }),
                datasets: [{
                    data: usersData.map(function(x) { return x.count; }),
                    backgroundColor: ['rgba(59, 130, 246, 0.8)', 'rgba(148, 163, 184, 0.8)', 'rgba(34, 197, 94, 0.8)', 'rgba(251, 191, 36, 0.8)'],
                    borderColor: ['rgba(59, 130, 246, 1)', 'rgba(148, 163, 184, 1)', 'rgba(34, 197, 94, 1)', 'rgba(251, 191, 36, 1)'],
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { position: 'bottom' } }
            }
        });
    }
    if (hardwareData.length > 0 && typeof Chart !== 'undefined') {
        new Chart(document.getElementById('chart-hardware'), {
            type: 'bar',
            data: {
                labels: hardwareData.map(function(x) { return x.label; }),
                datasets: [{
                    label: 'Count',
                    data: hardwareData.map(function(x) { return x.count; }),
                    backgroundColor: 'rgba(59, 130, 246, 0.6)',
                    borderColor: 'rgba(59, 130, 246, 1)',
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    y: { beginAtZero: true, ticks: { stepSize: 1 } }
                }
            }
        });
    }
    if (feedbackData.length > 0 && typeof Chart !== 'undefined') {
        new Chart(document.getElementById('chart-feedback'), {
            type: 'bar',
            data: {
                labels: feedbackData.map(function(x) { return 'Rating ' + x.rating; }),
                datasets: [{
                    label: 'Count',
                    data: feedbackData.map(function(x) { return x.count; }),
                    backgroundColor: 'rgba(34, 197, 94, 0.6)',
                    borderColor: 'rgba(34, 197, 94, 1)',
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    y: { beginAtZero: true, ticks: { stepSize: 1 } }
                }
            }
        });
    }
})();
</script>
}
